# weirdnet-relay: a relay and bootstrap node for the Weirdnet network.
#
# Install:
#   install -m 0755 weirdnet-relay /usr/bin/
#   install -D -m 0644 relay.toml /etc/weirdnet-relay/relay.toml
#   weirdnet-relay gen-key | systemd-creds encrypt --name=db-key - /etc/weirdnet-relay/db-key.cred
#   install -m 0644 weirdnet-relay.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now weirdnet-relay
#
# The database key reaches the service only as the credential `db-key`
# ($CREDENTIALS_DIRECTORY/db-key); it is never in the unit, the config or the environment.
# Without systemd-creds, keep a 0600 root-owned file and use LoadCredential= instead (below).

[Unit]
Description=Weirdnet relay
Documentation=https://net.weirdbrains.com/relay https://github.com/WeirdBrains/weirdnet-relay
Wants=network-online.target
After=network-online.target
# No database key, no start (see DEPLOY.md). With LoadCredential= instead, change this path.
ConditionPathExists=/etc/weirdnet-relay/db-key.cred

[Service]
Type=exec
ExecStart=/usr/bin/weirdnet-relay --config /etc/weirdnet-relay/relay.toml run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

LoadCredentialEncrypted=db-key:/etc/weirdnet-relay/db-key.cred
# LoadCredential=db-key:/etc/weirdnet-relay/db-key

DynamicUser=yes
StateDirectory=weirdnet-relay
StateDirectoryMode=0700
ConfigurationDirectory=weirdnet-relay
UMask=0077
Environment=RUST_BACKTRACE=0

# The relay binds 4747 (TCP and QUIC) and 127.0.0.1:4780; it needs no capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
