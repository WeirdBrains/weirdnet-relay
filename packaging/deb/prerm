#!/bin/sh
# weirdnet-relay prerm: stop and disable the service on removal (an upgrade restarts it in postinst).
set -e
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl stop weirdnet-relay.service >/dev/null 2>&1 || true
    systemctl disable weirdnet-relay.service >/dev/null 2>&1 || true
fi
exit 0
